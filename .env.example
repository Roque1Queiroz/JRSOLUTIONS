# ─────────────────────────────────────────
#  CONFIGURAÇÃO DO SISTEMA GESTOR
# ─────────────────────────────────────────

# Django — desenvolvimento local
DJANGO_DEBUG=True
# Gere uma chave exclusiva para cada ambiente. Nunca use esta linha como segredo real.
DJANGO_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_LOCAL_FORTE
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de Dados (PostgreSQL no Docker)
DB_TYPE=postgres
DB_NAME=sistema_gestor_dev
DB_USER=sistema_gestor
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL_FORTE
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/1

# Segurança (Produção/SaaS)
# SECURE_SSL_REDIRECT=False
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.com
