# ─── Exemplo de .env (copie para .env e preencha) ─────────────────────────────
# Decoração: os itens NOVOS (logging/email) estão marcados com [LOGGING]

# Obrigatórios em produção
DJANGO_SECRET_KEY=coloque-uma-chave-forte-aqui
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=jrsolutions.duckdns.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://jrsolutions.duckdns.org

# Banco (sqlite por padrão; use postgres para muitos clientes)
DB_TYPE=sqlite
#DB_TYPE=postgres
#DATABASE_URL=postgres://usuario:senha@localhost:5432/gestor

# Redis / Celery
REDIS_URL=redis://localhost:6379/1

# ─── [LOGGING] item 2 — AVISO DE ERRO 500 ─────────────────────────────────────
# Emails que recebem o aviso quando o sistema quebra (separados por vírgula)
DJANGO_ADMIN_EMAILS=seuemail@exemplo.com

# Para o aviso CHEGAR de verdade, configure um SMTP (ex.: "app password" do Gmail).
# Enquanto não configurar, o aviso só fica no log do processo (docker logs).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app
DEFAULT_FROM_EMAIL=sistema@jrsolutions.com.br
SERVER_EMAIL=sistema@jrsolutions.com.br

# ─── [LOGGING] item 1 — ARQUIVOS DE LOG ───────────────────────────────────────
# Onde gravar os logs (padrão: <projeto>/logs). Diretório é criado sozinho.
#DJANGO_LOG_DIR=/var/log/gestor

# ─── Asaas (pagamentos) ────────────────────────────────────────────────────────
ASAAS_API_KEY=coloque_a_chave_aqui
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=coloque_o_token_do_webhook

# ─── Bot (assistente de IA) ─────────────────────────────────────────
# Chave da Groq (https://console.groq.com/keys). Sem ela, o chat mostra
# "Assistente nao configurado" em vez de erro.
GROQ_API_KEY=
# URL interna do servico do bot na rede Docker do on-premise.
# NUNCA exponha 8003 no host — o Django faz proxy via /chatbot-api/.
CHATBOT_INTERNAL_URL=http://chatbot:8003
