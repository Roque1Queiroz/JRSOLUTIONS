# ─────────────────────────────────────────────
#  SISTEMA GESTOR — CONFIGURAÇÃO DO CLIENTE (ON-PREMISE)
#  Copie para .env e ajuste antes de subir, OU
#  rode "bash scripts/instalar.sh" (gera o .env
#  preenchido automaticamente com chaves novas).
# ─────────────────────────────────────────────

# Modo produção (False = usa Gunicorn, mais estável e seguro)
DJANGO_DEBUG=False

# Chave de segurança — use uma DIFERENTE em cada instalação.
# (o instalar.sh gera uma aleatória para você; nunca reutilize a da sua nuvem)
DJANGO_SECRET_KEY=TROQUE_POR_UMA_CHAVE_DIFERENTE

# Endereços que podem acessar o sistema.
# Coloque aqui o IP do servidor do cliente e/ou o nome da máquina.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,IP_DO_SERVIDOR

# Banco de dados PostgreSQL (padrão deste pacote).
# v2.5: DB_TYPE=postgres é OBRIGATÓRIO. Sem isso o settings cai no
# default `sqlite` e o app ignora o Postgres provisionado, criando
# um SQLite local isolado do que o compose está rodando.
DB_TYPE=postgres
DB_NAME=gestor
DB_USER=gestor
DB_PASSWORD=TROQUE_ESTA_SENHA_DO_BANCO
DB_HOST=db
DB_PORT=5432

# Redis / Celery (filas de tarefas)
REDIS_URL=redis://redis:6379/1

# ── On-premise pela rede local (HTTP) ─────────────────────────
# Instalação local normalmente NÃO tem HTTPS, então desligamos o
# redirecionamento para https e a exigência de cookies seguros.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Porta que o sistema vai "escutar" na máquina do cliente.
APP_PORT=8000

# ── Teste grátis de 30 dias ──────────────────────────────────
# O Sistema Gestor aceita "empresas em teste" (acesso total por 30 dias).
# No on-premise, quem ativa o teste é o José (vendedor) ou o administrador,
# via cadastro self-service (/cadastro/) ou pelo painel. Após o prazo, sem
# plano, o sistema mostra a tela de escolha de plano.
#
# ── Pagamentos (Asaas) — OPCIONAL ─────────────────────────────
# No on-premise, o pagamento normalmente é tratado como licença direta com o
# José (não mensal por Asaas). Estas variáveis só têm efeito se você for
# configurar cobrança recorrente; num cliente em rede local, o webhook de
# confirmação pode não ser alcançável e o plano é liberado manualmente.
# Deixe vazio (ou remova) se não for usar:
#ASAAS_API_KEY=
#ASAAS_BASE_URL=https://api.asaas.com/v3
#ASAAS_WEBHOOK_TOKEN=

# ─── Bot (assistente de IA) ─────────────────────────────────────────
# Chave da Groq (https://console.groq.com/keys). Sem ela, o chat mostra
# "Assistente nao configurado" em vez de erro.
GROQ_API_KEY=
# URL interna do servico do bot na rede Docker do on-premise.
# NUNCA exponha 8003 no host — o Django faz proxy via /chatbot-api/.
CHATBOT_INTERNAL_URL=http://chatbot:8003
