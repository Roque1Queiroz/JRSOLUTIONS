# Git/Hermes local
.hermes/

# Pacote on-premise — o CÓDIGO é versionado (compose, chatbot, scripts, README,
# testes do pacote). Fica de fora só o que é GERADO: dist/ (zips entregues ao
# cliente), app/ (cópia do código montada na hora) e os segredos (.env).
deploy-cliente/dist/
deploy-cliente/app/

# Logs do sistema (rotação diária) — nunca versionar
logs/
*.log
.env

# Backups temporarios de deploy - nunca versionar
*.bak_*
